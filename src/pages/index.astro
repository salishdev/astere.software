---
import AppShowcase from '@/components/AppShowcase.astro'
import Container from '@/components/Container.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { description, tagline } from '@/lib/metadata'
---

<BaseLayout>
  <Container class="mt-9">
    <div class="max-w-2xl">
      <h1 class="text-4xl font-bold tracking-tight text-zinc-800 dark:text-zinc-100">
        {tagline}
      </h1>
      <p class="my-6 text-2xl text-zinc-600 dark:text-zinc-400">
        {description}
      </p>
    </div>
  </Container>
  <AppShowcase />
  <Container class="mt-24 md:mt-28">
    <div class="mx-auto grid max-w-xl grid-cols-1 gap-y-20 lg:max-w-none lg:grid-cols-2">
      <div class="flex flex-col gap-16"></div>
      <div class="space-y-10 lg:pl-16 xl:pl-24"></div>
    </div>
  </Container>
</BaseLayout>
